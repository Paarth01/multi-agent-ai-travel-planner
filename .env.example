# Own flight data service — recommended, no signup needed.
# Run: uvicorn data_service.app:app --port 8100
OWN_FLIGHT_SERVICE_URL=http://localhost:8100

# Own hotel data service — same running service, same reasoning.
OWN_HOTEL_SERVICE_URL=http://localhost:8100

# Own activity data service — same running service. Narrower coverage
# than flights/hotels (real ASI/museum fees, 4 cities, history/nature
# categories only) -- see data_service/README.md.
OWN_ACTIVITY_SERVICE_URL=http://localhost:8100

# Optional — leave blank to run entirely on mock data (zero setup).
# Get test credentials at https://developers.amadeus.com/self-service
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# Optional — leave blank to run entirely on mock data.
# Get a key at https://console.cloud.google.com/ (enable Places API)
GOOGLE_PLACES_API_KEY=

# CORS Origins — comma-separated list of allowed frontend URLs.
# Defaults to "*" for local dev. Set this explicitly before deploying.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

HTTP_TIMEOUT_SECONDS=8.0

# Caching for live API responses (see cache/). Leave blank to use an
# in-memory cache automatically (fine for local dev/demo — resets on
# restart, not shared across worker processes). Set this for anything
# beyond a single-process local run.
REDIS_URL=
PRICE_CACHE_TTL_SECONDS=900
REFERENCE_CACHE_TTL_SECONDS=86400
